{
  "name": "@metamask/eth-money-keyring",
  "version": "4.0.0",
  "description": "A money account keyring that wraps the HD keyring with a different keyring type and derivation path",
  "keywords": [
    "ethereum",
    "keyring"
  ],
  "homepage": "https://github.com/MetaMask/accounts/tree/main/packages/keyring-eth-money#readme",
  "bugs": {
    "url": "https://github.com/MetaMask/accounts/issues"
  },
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/MetaMask/accounts.git"
  },
  "files": [
    "dist/",
    "v2.js"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./v2": {
      "types": "./dist/v2/index.d.ts",
      "default": "./dist/v2/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "build:all": "tsc --build tsconfig.build.json --verbose",
    "build:clean": "yarn build --clean",
    "build:docs": "typedoc",
    "changelog:update": "../../scripts/update-changelog.sh @metamask/eth-money-keyring",
    "changelog:validate": "../../scripts/validate-changelog.sh @metamask/eth-money-keyring",
    "publish:preview": "yarn npm publish --tag preview",
    "since-latest-release": "../../scripts/since-latest-release.sh",
    "test": "yarn test:source && yarn test:types",
    "test:clean": "jest --clearCache",
    "test:source": "jest --reporters=jest-silent-reporter",
    "test:types": "../../scripts/tsd-test.sh ./src",
    "test:verbose": "jest --verbose",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@metamask/eth-hd-keyring": "^15.0.0",
    "@metamask/keyring-api": "^24.1.0",
    "@metamask/keyring-sdk": "^3.1.0",
    "@metamask/keyring-utils": "^5.0.0",
    "@metamask/superstruct": "^3.4.1",
    "async-mutex": "^0.5.0"
  },
  "devDependencies": {
    "@lavamoat/allow-scripts": "^3.2.1",
    "@lavamoat/preinstall-always-fail": "^2.1.0",
    "@metamask/auto-changelog": "^6.1.0",
    "@metamask/eth-sig-util": "^9.0.0",
    "@metamask/key-tree": "^10.0.2",
    "@metamask/utils": "^11.11.0",
    "@types/jest": "^29.5.12",
    "deepmerge": "^4.2.2",
    "jest": "^29.5.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "lavamoat": {
    "allowScripts": {
      "@lavamoat/preinstall-always-fail": false
    }
  }
}
