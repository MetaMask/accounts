{
  "name": "@metamask/eth-ledger-bridge-keyring",
  "version": "13.1.0",
  "description": "A MetaMask compatible keyring, for ledger hardware wallets",
  "keywords": [
    "ethereum",
    "keyring",
    "ledger",
    "metamask"
  ],
  "homepage": "https://github.com/MetaMask/accounts/tree/main/packages/keyring-eth-ledger-bridge#readme",
  "bugs": {
    "url": "https://github.com/MetaMask/accounts/issues"
  },
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/MetaMask/accounts.git"
  },
  "files": [
    "dist/",
    "v2.js",
    "!dist/**/__testhelpers__"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./v2": {
      "types": "./dist/v2/index.d.ts",
      "default": "./dist/v2/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "build:all": "tsc --build tsconfig.build.json --verbose",
    "build:clean": "yarn build --clean",
    "build:docs": "typedoc",
    "changelog:update": "../../scripts/update-changelog.sh @metamask/eth-ledger-bridge-keyring",
    "changelog:validate": "../../scripts/validate-changelog.sh @metamask/eth-ledger-bridge-keyring",
    "publish:preview": "yarn npm publish --tag preview",
    "since-latest-release": "../../scripts/since-latest-release.sh",
    "test": "yarn test:source && yarn test:types",
    "test:clean": "jest --clearCache",
    "test:source": "jest --reporters=jest-silent-reporter",
    "test:types": "../../scripts/tsd-test.sh ./src",
    "test:verbose": "jest --verbose",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@ethereumjs/rlp": "^5.0.2",
    "@ethereumjs/tx": "^5.4.0",
    "@ethereumjs/util": "^9.1.0",
    "@ledgerhq/context-module": "^2.1.0",
    "@ledgerhq/device-management-kit": "^1.7.1",
    "@ledgerhq/device-signer-kit-ethereum": "^1.16.0",
    "@ledgerhq/hw-app-eth": "^6.42.0",
    "@ledgerhq/hw-transport": "^6.31.3",
    "@metamask/eth-sig-util": "^9.0.0",
    "@metamask/hw-wallet-sdk": "^1.0.0",
    "@metamask/keyring-api": "^24.1.0",
    "@metamask/keyring-sdk": "^3.1.0",
    "hdkey": "^2.1.0",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@ethereumjs/common": "^4.4.0",
    "@lavamoat/allow-scripts": "^3.2.1",
    "@lavamoat/preinstall-always-fail": "^2.1.0",
    "@ledgerhq/types-cryptoassets": "^7.15.1",
    "@ledgerhq/types-devices": "^6.25.3",
    "@ledgerhq/types-live": "^6.52.0",
    "@metamask/account-api": "^2.0.0",
    "@metamask/auto-changelog": "^6.1.0",
    "@metamask/keyring-utils": "^5.0.0",
    "@metamask/utils": "^11.11.0",
    "@types/ethereumjs-tx": "^1.0.1",
    "@types/hdkey": "^2.0.1",
    "@types/jest": "^29.5.12",
    "@types/web": "^0.0.69",
    "@types/ws": "^8.18.1",
    "deepmerge": "^4.2.2",
    "depcheck": "^1.4.7",
    "ethereum-cryptography": "^2.2.1",
    "ethereumjs-tx": "^1.3.7",
    "jest": "^29.5.0",
    "jest-it-up": "^3.1.0",
    "ts-jest": "^29.0.5",
    "ts-node": "^10.9.2",
    "typedoc": "^0.25.13",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "lavamoat": {
    "allowScripts": {
      "@lavamoat/preinstall-always-fail": false,
      "@ledgerhq/hw-app-eth>@ledgerhq/domain-service>eip55>keccak": false,
      "ethereumjs-tx>ethereumjs-util>keccak": false,
      "ethereumjs-tx>ethereumjs-util>secp256k1": false,
      "hdkey>secp256k1": false,
      "ethereumjs-tx>ethereumjs-util>ethereum-cryptography>keccak": false
    }
  }
}
