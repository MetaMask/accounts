{
  "name": "@metamask/eth-mpc-keyring",
  "version": "0.0.0",
  "description": "A Keyring for Ethereum accounts that uses Multi-Party Computation (MPC) for key management and signing",
  "keywords": [
    "ethereum",
    "keyring"
  ],
  "homepage": "https://github.com/MetaMask/accounts/tree/main/packages/keyring-eth-mpc#readme",
  "bugs": {
    "url": "https://github.com/MetaMask/accounts/issues"
  },
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/MetaMask/accounts.git"
  },
  "files": [
    "dist/",
    "v2.js"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./v2": {
      "types": "./dist/v2/index.d.ts",
      "default": "./dist/v2/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "build:clean": "yarn build --clean",
    "build:docs": "typedoc",
    "changelog:update": "../../scripts/update-changelog.sh @metamask/eth-mpc-keyring",
    "changelog:validate": "../../scripts/validate-changelog.sh @metamask/eth-mpc-keyring",
    "publish:preview": "yarn npm publish --tag preview",
    "test": "yarn test:source && yarn test:types",
    "test:clean": "jest --clearCache",
    "build:all": "tsc --build tsconfig.build.json --verbose",
    "since-latest-release": "../../scripts/since-latest-release.sh",
    "test:source": "jest --reporters=jest-silent-reporter",
    "test:types": "../../scripts/tsd-test.sh ./src",
    "test:verbose": "jest --verbose",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@metamask/keyring-api": "^24.1.0",
    "@metamask/keyring-sdk": "^3.1.0",
    "@metamask/keyring-utils": "^5.0.0",
    "@metamask/utils": "^11.11.0"
  },
  "devDependencies": {
    "@ethereumjs/tx": "^5.4.0",
    "@lavamoat/allow-scripts": "^3.2.1",
    "@lavamoat/preinstall-always-fail": "^2.1.0",
    "@metamask/auto-changelog": "^6.1.0",
    "@metamask/eth-sig-util": "^9.0.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.13.14",
    "@typescript/native": "npm:typescript@^7.0.2",
    "deepmerge": "^4.2.2",
    "depcheck": "^1.4.7",
    "jest": "^29.5.0",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typedoc": "^0.25.13",
    "typescript": "patch:typescript@npm%3A6.0.3#~/.yarn/patches/typescript-npm-6.0.3-585eecd158.patch"
  },
  "engines": {
    "node": ">=22"
  },
  "lavamoat": {
    "allowScripts": {
      "@lavamoat/preinstall-always-fail": false
    }
  }
}
