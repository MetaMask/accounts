{
  "name": "@metamask/key-derivation-purposes",
  "version": "0.0.0",
  "description": "Shared registry of MetaMask key-derivation purposes",
  "keywords": [
    "key-derivation",
    "metamask"
  ],
  "homepage": "https://github.com/MetaMask/accounts/tree/main/packages/key-derivation-purposes#readme",
  "bugs": {
    "url": "https://github.com/MetaMask/accounts/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MetaMask/accounts.git"
  },
  "files": [
    "dist/"
  ],
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "ts-bridge --project tsconfig.build.json --verbose --clean --no-references",
    "build:all": "ts-bridge --project tsconfig.build.json --verbose --clean",
    "build:clean": "yarn build --clean",
    "build:docs": "typedoc",
    "changelog:update": "../../scripts/update-changelog.sh @metamask/key-derivation-purposes",
    "changelog:validate": "../../scripts/validate-changelog.sh @metamask/key-derivation-purposes",
    "since-latest-release": "../../scripts/since-latest-release.sh",
    "test": "yarn test:source && yarn test:types",
    "test:clean": "jest --clearCache",
    "test:source": "jest --reporters=jest-silent-reporter",
    "test:types": "../../scripts/tsd-test.sh ./src",
    "test:verbose": "jest --verbose",
    "test:watch": "jest --watch"
  },
  "devDependencies": {
    "@lavamoat/allow-scripts": "^5.1.0",
    "@lavamoat/preinstall-always-fail": "^3.0.1",
    "@metamask/auto-changelog": "^6.1.0",
    "@ts-bridge/cli": "^0.6.3",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.19.0",
    "depcheck": "^1.4.7",
    "jest": "^29.5.0",
    "ts-jest": "^29.0.5",
    "ts-node": "^10.9.2",
    "tsd": "^0.31.0",
    "typedoc": "^0.25.13",
    "typescript": "~5.8.3"
  },
  "tsd": {
    "compilerOptions": {
      "composite": "false"
    },
    "directory": "src"
  },
  "engines": {
    "node": ">=22"
  },
  "lavamoat": {
    "allowScripts": {
      "@lavamoat/preinstall-always-fail": false
    }
  }
}
