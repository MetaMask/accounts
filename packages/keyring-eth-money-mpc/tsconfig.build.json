{
  "extends": "../../tsconfig.packages.build.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    // `@metamask/cryptography/aes-gcm` references DOM types (e.g.
    // `BufferSource`) in its declarations. The "DOM" lib resolves to the
    // `@types/web` package via the root `@typescript/lib-dom` resolution.
    "lib": ["ES2020", "DOM"]
  },
  "references": [
    {
      "path": "../account-api/tsconfig.build.json"
    },
    {
      "path": "../keyring-utils/tsconfig.build.json"
    },
    {
      "path": "../keyring-api/tsconfig.build.json"
    },
    {
      "path": "../keyring-sdk/tsconfig.build.json"
    }
  ],
  "include": ["./src/**/*.ts"],
  "exclude": ["./src/**/*.test.ts"]
}
